def r(v):
    if v is None or v=='': return '<p class="muted">Not specified.</p>'
    if isinstance(v,bool): return f'<p>{"Yes" if v else "No"}</p>'
    if isinstance(v,(int,float)): return f'<p>{v}</p>'
    if isinstance(v,list): return '<ul>'+''.join(f'<li>{r(x) if isinstance(x,(dict,list)) else E(x)}</li>' for x in v)+'</ul>'
    if isinstance(v,dict): return '<dl>'+''.join(f'<dt>{E(k.replace("_"," ").title())}</dt><dd>{r(x)}</dd>' for k,x in v.items())+'</dl>'
    return f'<p>{E(v)}</p>'

def block(label,v): return f'<section class="fact"><h4>{E(label)}</h4>{r(v)}</section>'
def chips(items): return '<div class="chips">'+''.join(f'<span>{E(x)}</span>' for x in items)+'</div>'

def workflow(w,i):
    fields=[('Buyer trigger',w.get('triggerEvents')),('Pain and fear',w.get('painAndFear')),('Promise',w.get('promise')),('Business outcomes',w.get('businessOutcomes')),('Scope',w.get('scope')),('Deliverables',w.get('deliverables')),('Exclusions',w.get('exclusions')),('Required inputs',w.get('requiredInputs')),('Discovery questions',w.get('discoveryQuestions')),('Qualification',w.get('qualification')),('Sales narrative',w.get('salesNarrative')),('Objections',w.get('objections')),('ROI model',w.get('roiModel')),('Implementation phases',w.get('implementationPhases')),('Dependencies',w.get('dependencies')),('Risks',w.get('risks')),('Upsells',w.get('upsells')),('Renewal motion',w.get('renewalMotion')),('Talk tracks',w.get('talkTracks')),('Marketing assets',w.get('marketingAssets')),('Assumptions',w.get('assumptions'))]
    return f'''<article class="workflow" id="{E(w['id'])}"><details><summary><span class="rank">{i:02}</span><div><div class="meta">{E(w.get('category',''))} · {E(w.get('priority',''))} · {E(w.get('evidenceStatus',''))}</div><h3>{E(w['title'])}</h3><p>{E(w.get('promise',''))}</p>{chips(w.get('buyers',[]))}</div><strong class="price">{E(w.get('price','Qualified scope'))}</strong></summary><div class="facts">{''.join(block(a,b) for a,b in fields)}</div></details></article>'''

def card(title,body,kicker=''):
    return f'<article class="card">{f"<span class=kicker>{E(kicker)}</span>" if kicker else ""}<h3>{E(title)}</h3>{r(body)}</article>'

